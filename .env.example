# Copy this file to .env and set real values.
# Do not commit .env.

# PostgreSQL container (docker-compose)
POSTGRES_DB=tariffication_db
POSTGRES_USER=tarif_user
POSTGRES_PASSWORD=tarif_password

# Application datasource (Spring/Hibernate)
DB_URL=jdbc:postgresql://localhost:5432/tariffication_db
DB_USERNAME=tarif_user
DB_PASSWORD=tarif_password
APP_ADMIN_USERNAME=admin
APP_ADMIN_PASSWORD=admin

# Mail settings
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your.mail@example.com
SMTP_PASSWORD=change_me_smtp_password
SMTP_USE_SSL=false
SMTP_USE_TLS=true
SMTP_DEFAULT_RECIPIENTS=recipient1@example.com,recipient2@example.com
SMTP_DEFAULT_SUBJECT=Тарификация - автоматическая отправка
