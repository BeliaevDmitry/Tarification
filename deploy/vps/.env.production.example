# Domain pointing to your VPS public IP.
APP_DOMAIN=tarification.example.com

# PostgreSQL
POSTGRES_DB=tariffication_db
POSTGRES_USER=tarif_user
POSTGRES_PASSWORD=change_me_postgres_password
DB_PASSWORD=change_me_postgres_password

# Initial application admin
APP_ADMIN_USERNAME=admin
APP_ADMIN_PASSWORD=change_me_admin_password
APP_ADMIN_FULL_NAME=Главный администратор

# SMTP
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your.mail@example.com
SMTP_PASSWORD=change_me_smtp_password
SMTP_USE_SSL=false
SMTP_USE_TLS=true
SMTP_DEFAULT_RECIPIENTS=recipient1@example.com,recipient2@example.com
SMTP_DEFAULT_SUBJECT=Тарификация - автоматическая отправка

# Optional JVM tuning
JAVA_OPTS=-Xms256m -Xmx1024m
