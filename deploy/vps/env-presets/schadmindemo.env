STACK_NAME=schadmindemo
APP_DOMAIN=schadmindemo.ru
SERVER_SERVLET_SESSION_COOKIE_SECURE=true
POSTGRES_DB=tariffication_db_demo
POSTGRES_USER=tarif_user_demo
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD_DEMO
DB_PASSWORD=CHANGE_ME_STRONG_PASSWORD_DEMO
APP_ADMIN_USERNAME=demo_admin
APP_ADMIN_PASSWORD=CHANGE_ME_ADMIN_PASSWORD_DEMO
APP_ADMIN_FULL_NAME=Администратор Demo
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your.mail@example.com
SMTP_PASSWORD=CHANGE_ME_SMTP_PASSWORD
SMTP_USE_SSL=false
SMTP_USE_TLS=true
SMTP_DEFAULT_RECIPIENTS=recipient1@example.com,recipient2@example.com
SMTP_DEFAULT_SUBJECT=Тарификация DEMO - автоматическая отправка
JAVA_OPTS=-Xms512m -Xmx1536m -XX:+UseG1GC -XX:MaxGCPauseMillis=200
