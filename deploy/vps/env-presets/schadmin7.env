# Optional JVM tuning
# Для VPS 8ГБ RAM / 2 vCPU:
# ограничиваем heap, чтобы процесс Java не съедал всю память и не попадал под OOM Killer.
JAVA_OPTS=-Xms512m -Xmx2048m -XX:+UseG1GC -XX:MaxGCPauseMillis=200